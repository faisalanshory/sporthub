generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ─── ENUMS ──────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  CUSTOMER
}

enum BookingStatus {
  PENDING_PAYMENT
  PAID
  CONFIRMED
  COMPLETED
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum PaymentMethod {
  QRIS
  BANK_TRANSFER
  EWALLET
  CREDIT_CARD
}

enum EventStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}



enum HighlightType {
  IMAGE
  VIDEO
}

// ─── USER ───────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(CUSTOMER)
  phone     String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings           Booking[]
  eventRegistrations EventRegistration[]
  createdEvents      Event[]
  articles           Article[]
  sessions           UserSession[]
}

model UserSession {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── VENUE ───────────────────────────────────────────────────────────────────

model Venue {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  address     String?
  phone       String?
  email       String?
  website     String?
  logoUrl     String?
  coverUrl    String?
  images      String?  // JSON array of URLs
  facilities  String?  // JSON array of strings
  mapUrl      String?
  openTime    String   @default("07:00")
  closeTime   String   @default("22:00")
  socialIG    String?
  socialTT    String?
  socialYT    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sports Sport[]
  events Event[]
}

// ─── SPORT ───────────────────────────────────────────────────────────────────

model Sport {
  id          String  @id @default(uuid())
  venueId     String
  name        String
  slug        String
  icon        String? // emoji or icon name
  description String?
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  venue   Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  courts  Court[]
  events  Event[]

  @@unique([venueId, slug])
}

// ─── COURT ───────────────────────────────────────────────────────────────────

model Court {
  id          String  @id @default(uuid())
  sportId     String
  name        String
  slug        String
  description String?
  capacity    Int     @default(4)
  pricePerHour Float
  images      String? // JSON array
  facilities  String? // JSON array
  isActive    Boolean @default(true)
  isIndoor    Boolean @default(true)
  openTime    String? // Override venue hours
  closeTime   String?

  sport    Sport         @relation(fields: [sportId], references: [id], onDelete: Cascade)
  layout   CourtLayout?
  bookingItems BookingItem[]

  @@unique([sportId, slug])
}

model CourtLayout {
  id       String @id @default(uuid())
  courtId  String @unique
  x        Float  @default(0)
  y        Float  @default(0)
  width    Float  @default(120)
  height   Float  @default(80)
  rotation Float  @default(0)

  court Court @relation(fields: [courtId], references: [id], onDelete: Cascade)
}

// ─── BOOKING ─────────────────────────────────────────────────────────────────

model Booking {
  id          String        @id @default(uuid())
  reference   String        @unique
  userId      String?       // null = guest
  guestName   String?
  guestEmail  String?
  guestPhone  String?
  serviceFee  Float         @default(5000)
  totalAmount Float
  status      BookingStatus @default(PENDING_PAYMENT)
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user    User?         @relation(fields: [userId], references: [id])
  items   BookingItem[]
  payment Payment?
  event   Event?
}

model BookingItem {
  id        String   @id @default(uuid())
  bookingId String
  courtId   String
  date      DateTime // Date only
  startTime String   // "09:00"
  endTime   String   // "10:00"
  price     Float

  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  court     Court   @relation(fields: [courtId], references: [id])
}

model Payment {
  id        String        @id @default(uuid())
  bookingId String        @unique
  method    PaymentMethod
  amount    Float
  status    PaymentStatus @default(PENDING)
  paidAt    DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

// ─── EVENTS ──────────────────────────────────────────────────────────────────

model Event {
  id              String      @id @default(uuid())
  venueId         String
  sportId         String?
  title           String
  slug            String      @unique
  description     String?
  coverImage      String?
  date            DateTime
  startTime       String
  endTime         String
  location        String?
  maxParticipants Int?
  fee             Float       @default(0)
  status          EventStatus @default(UPCOMING)
  
  // New fields for User Event Creation
  isPrivate       Boolean     @default(false)
  privateCode     String?
  gallery         String?     // JSON array of image URLs
  creatorId       String?
  bookingId       String?     @unique

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  venue         Venue               @relation(fields: [venueId], references: [id])
  sport         Sport?              @relation(fields: [sportId], references: [id])
  creator       User?               @relation(fields: [creatorId], references: [id])
  booking       Booking?            @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  registrations EventRegistration[]
}

model EventRegistration {
  id        String   @id @default(uuid())
  eventId   String
  userId    String
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

// ─── ARTICLES ────────────────────────────────────────────────────────────────

model Article {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  content     String
  coverImage  String?
  authorId    String
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author      User     @relation(fields: [authorId], references: [id])
}



// ─── HIGHLIGHTS ──────────────────────────────────────────────────────────────

model Highlight {
  id          String        @id @default(uuid())
  title       String
  description String?
  type        HighlightType @default(IMAGE)
  mediaUrl    String
  thumbnailUrl String?
  courtName   String?
  sportName   String?
  isActive    Boolean       @default(true)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
}
